# This package requires no runtime environment variables for the CLI itself.
# Copy to `.env` only if you add private overrides locally (do not commit `.env`).

# Optional host-agent compare (`bun run agent:test`). Not part of `bun run check`.
# Export these in the shell — the agent-test CLI does not auto-load `.env`.
# Use one mode. If both are set, CURSOR_AUTH_MODE=subscription ignores the key.
# CURSOR_AUTH_MODE=api-key
# CURSOR_API_KEY=

# Optional model overrides for a host run / judge
# CURSOR_AGENT_MODEL=
# CURSOR_JUDGE_MODEL=

# Optional harness knobs — see @post-print/agent-test README
# AGENT_TEST_DEBUG=1
# AGENT_TEST_TIMEOUT_MS=600000
