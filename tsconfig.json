{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"types": ["bun"]
	},
	"include": [
		"src/**/*.ts",
		"scripts/**/*.ts",
		"agent-suites/**/*.ts",
		"agent-test*.config.ts",
		"tests/sdk-contracts/**/*.ts"
	]
}
