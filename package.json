{
	"name": "@csark0812/skeleton",
	"version": "5.0.1",
	"description": "SSOT audit CLI for agent harness repos",
	"type": "module",
	"bin": {
		"skeleton": "dist/cli.js"
	},
	"exports": {
		"./plugin-types": {
			"types": "./dist/plugin-types.d.ts",
			"default": "./dist/plugin-types.js"
		},
		"./result-types": {
			"types": "./dist/result-types.d.ts",
			"default": "./dist/result-types.js"
		},
		"./schemas/config.schema.json": "./schemas/config.schema.json",
		"./schemas/policy-file.schema.json": "./schemas/policy-file.schema.json",
		"./schemas/result.schema.json": "./schemas/result.schema.json"
	},
	"files": [
		"dist",
		"templates",
		"schemas",
		"skeleton"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/csark0812/skeleton.git"
	},
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"packageManager": "bun@1.2.21",
	"scripts": {
		"build": "bun build src/cli.ts --target=node --outfile=dist/cli.js && bun build src/plugin-types.ts --target=node --format=esm --outfile=dist/plugin-types.js --packages=external && bun build src/result-types.ts --target=node --format=esm --outfile=dist/result-types.js --packages=external && tsc -p tsconfig.types.json",
		"test": "bun run agent:test:prepare && bun test ./src",
		"test:audit": "bun test ./src/audit/__tests__",
		"test:cli": "bun test ./src/__tests__/cli",
		"test:coverage": "bun run agent:test:prepare && bun test --coverage ./src",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "biome check .",
		"format": "biome format --write .",
		"format:check": "biome check --formatter-enabled=true --linter-enabled=false .",
		"audit:deps": "bun audit",
		"validate:changed": "bun src/cli.ts validate changed",
		"validate:ci": "bun src/cli.ts validate changed --base origin/main",
		"audit:docs": "bun src/cli.ts audit docs",
		"audit:skills": "bun src/cli.ts audit skills",
		"audit:self": "bun src/cli.ts audit self",
		"check": "bun run lint && bun run test && bun run typecheck && bun run build && bun run audit:self",
		"verify:package": "bun run build && bun scripts/verify-package.ts",
		"start": "bun src/cli.ts --help",
		"dev": "bun src/cli.ts --help",
		"agent:test:check": "bun run agent:test:prepare && agent-test test --list && bun run agent:test:offline",
		"agent:test": "bun run agent:test:prepare && bun scripts/run-efficacy.ts",
		"agent:test:matrix": "bun run agent:test:prepare && bun scripts/run-efficacy.ts --host all",
		"pack:efficacy-vendor": "bun scripts/pack-efficacy-vendor.ts",
		"prepack": "bun run check && bun scripts/verify-package.ts",
		"agent:test:prepare": "bun run build && bun scripts/write-efficacy-fixtures.ts && bun scripts/efficacy/write-history.ts && bun scripts/efficacy/write-tradeoffs.ts && bun scripts/pack-efficacy-vendor.ts",
		"agent:test:offline": "agent-test test --config=agent-test.offline.config.ts"
	},
	"dependencies": {
		"ajv": "8.20.0",
		"github-slugger": "2.0.0",
		"remark": "15.0.1",
		"remark-gfm": "4.0.1",
		"smol-toml": "1.8.0",
		"tinyglobby": "0.2.14",
		"unist-util-visit": "5.0.0",
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"@cursor/sdk": "^1.0.27",
		"@post-print/agent-harness": "2.0.5",
		"@post-print/agent-test": "2.0.5",
		"@types/bun": "1.4.2",
		"@types/github-slugger": "2.0.0",
		"typescript": "~7.0.2"
	},
	"overrides": {
		"fast-uri": "3.1.6",
		"undici": "6.28.0"
	}
}
